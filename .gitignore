# Environment & Secrets
.env
# `.env` above matches that basename only, so per-deployment env files need
# naming explicitly or they get committed.
.env.dev
# Production's image pin, written by planboard's scripts/deploy-production.sh.
services/planboard/docker-compose.override.yml
*.key
*.pem

# Cloudflare Tunnel credentials (contains tunnel secret)
core/cloudflared/credentials.json

# Logs
**/logs/
*.log
**/*.log
n8nEventLog*

# Python
__pycache__/
*.pyc

# Backups written by editor/deploy tooling
*.bak
*.bak-*

# Local binary tooling (downloaded, not vendored)
obscura
obscura-*-linux.tar.gz

# OS files
.DS_Store
Thumbs.db

# Antigravity CLI settings
.antigravitycli/

