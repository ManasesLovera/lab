# Monitor dashboard — configuration template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is
# tracked and must never contain a real credential.
#
#   cp example.env .env

# --- Auth (required) ------------------------------------------------------
# HTTP Basic auth protects the whole dashboard, including the SSE stream.
# The app refuses to start if these are unset.
MONITOR_USER=admin
MONITOR_PASS=change-me

# --- Server ---------------------------------------------------------------
# Port the app listens on inside the container (nginx proxies to this).
PORT=8080
