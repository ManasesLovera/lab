# Planboard — configuration template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is
# tracked and must never contain a real credential.
#
#   cp example.env .env

# --- Database -------------------------------------------------------------
# PB_DB selects the driver: "sqlite" or "postgres".
PB_DB=postgres

# Postgres connection URL. Only read when the driver is postgres.
# The password is percent-encoded inside the URL. `#` in particular MUST be
# written as %23: unencoded, it starts a URL fragment and silently truncates
# the password.
PB_DATABASE_URL=postgres://weleec_planboard:REDACTED@postgres:5432/weleec_planboard

# --- Auth -----------------------------------------------------------------
# Overrides the login throttle (5 attempts per 15 minutes, keyed by IP).
# Leave unset in production.
# PB_LOGIN_MAX_ATTEMPTS=1000