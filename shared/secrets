#!/usr/bin/env python3
"""secrets - Lab credential & database manager.

Stores structured credential entries in a local SQLite database.
Plaintext-at-rest with owner-only permissions (700 dir / 600 db).
"""

from __future__ import annotations

import csv
import getpass
import io
import json
import os
import secrets as pysecrets
import sqlite3
import subprocess
import sys

LAB_DIR = os.environ.get("LAB_DIR", "/home/mlovera/lab")
DB_PATH = os.environ.get("SECRETS_DB", os.path.join(LAB_DIR, "shared", "data", "secrets.db"))
SEARCH_DIRS = ("core", "external", "services")

TYPES = ("login", "api_key", "database", "ssh", "note", "env", "totp")
FIELDS = ("type", "url", "username", "password", "description", "tags", "meta")
LABELS = {
    "type": "Type",
    "url": "URL",
    "username": "Username",
    "password": "Password",
    "description": "Description",
    "tags": "Tags",
    "meta": "Meta",
}


# ---------------------------------------------------------------- output utils
def _color(code: str, s: str) -> str:
    if sys.stdout.isatty() and os.environ.get("NO_COLOR") is None:
        return f"\033[{code}m{s}\033[0m"
    return s


def cyan(s): return _color("0;36", s)
def green(s): return _color("0;32", s)
def yellow(s): return _color("1;33", s)
def red(s): return _color("0;31", s)
def bold(s): return _color("1", s)
def dim(s): return _color("2", s)


def die(msg: str, code: int = 1):
    print(red(f"Error: {msg}"), file=sys.stderr)
    sys.exit(code)


# ------------------------------------------------------------------- database
def enforce_perms():
    try:
        os.chmod(os.path.dirname(DB_PATH), 0o700)
        if os.path.exists(DB_PATH):
            os.chmod(DB_PATH, 0o600)
    except OSError:
        pass


def table_exists(conn, name: str) -> bool:
    return conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (name,)
    ).fetchone() is not None


def migrate_legacy(conn):
    """Convert the old flat secrets(key,value) table into structured entries."""
    if not table_exists(conn, "secrets"):
        return 0
    rows = {k: v for k, v in conn.execute("SELECT key, value FROM secrets")}
    used: set[str] = set()
    migrated = 0

    for key, value in rows.items():
        if not key.endswith("_password"):
            continue
        base = key[: -len("_password")]
        user = rows.get(base + "_user")
        used.update({key, base + "_user"})
        if base.startswith("postgres_"):
            dbname = base[len("postgres_"):]
            if dbname == "admin":
                dbname, user = "postgres", (user or "admin")
            else:
                user = user or dbname
            meta = {"host": "postgres", "port": 5432, "database": dbname}
        else:
            meta = {}
        conn.execute(
            "INSERT OR IGNORE INTO entries "
            "(name, type, url, username, password, description, meta) "
            "VALUES (?, ?, ?, ?, ?, ?, ?)",
            (base, "database", "postgres:5432", user, value,
             f"Migrated from legacy key {key}", json.dumps(meta) if meta else None),
        )
        migrated += 1

    for key, value in rows.items():
        if key in used:
            continue
        conn.execute(
            "INSERT OR IGNORE INTO entries (name, type, password, description) "
            "VALUES (?, ?, ?, ?)",
            (key, "note", value, "Migrated from legacy key"),
        )
        migrated += 1

    conn.execute("DROP TABLE secrets")
    return migrated


def init_db(conn):
    conn.execute(
        """CREATE TABLE IF NOT EXISTS entries (
            id          INTEGER PRIMARY KEY,
            name        TEXT UNIQUE NOT NULL,
            type        TEXT,
            url         TEXT,
            username    TEXT,
            password    TEXT,
            description TEXT,
            tags        TEXT,
            meta        TEXT,
            created_at  DATETIME DEFAULT CURRENT_TIMESTAMP,
            updated_at  DATETIME DEFAULT CURRENT_TIMESTAMP
        )"""
    )
    conn.execute(
        """CREATE TABLE IF NOT EXISTS user_creation_log (
            id          INTEGER PRIMARY KEY,
            timestamp   DATETIME DEFAULT CURRENT_TIMESTAMP,
            type        TEXT,
            dbname      TEXT,
            username    TEXT,
            permissions TEXT
        )"""
    )
    migrated = migrate_legacy(conn)
    conn.commit()
    enforce_perms()
    if migrated:
        print(yellow(f"Migrated {migrated} legacy secret(s) into structured entries."))


def connect():
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    init_db(conn)
    return conn


def resolve(conn, name: str):
    """Return (row, implied_field). Supports legacy *_password / *_user names."""
    row = conn.execute("SELECT * FROM entries WHERE name = ?", (name,)).fetchone()
    if row:
        return row, None
    for suffix, field in (("_password", "password"), ("_user", "username")):
        if name.endswith(suffix):
            row = conn.execute(
                "SELECT * FROM entries WHERE name = ?",
                (name[: -len(suffix)],),
            ).fetchone()
            if row:
                return row, field
    return None, None


# --------------------------------------------------------------- arg parsing
ALIASES = {
    "-t": "type", "-u": "username", "-d": "description",
    "-f": "field", "-g": "generate", "-s": "show-passwords", "-y": "yes",
}
VALUE_OPTS = {"type", "url", "username", "description", "tags", "meta", "field", "tag",
              "format", "output"}
FLAG_OPTS = {"json", "show-passwords", "generate", "yes", "force", "password-stdin",
             "extended", "no-passwords"}


def parse_args(argv):
    pos, opts = [], {}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            pos.extend(argv[i + 1:])
            break
        if a.startswith("-") and a != "-":
            key, eq, val = a.partition("=")
            key = ALIASES.get(key, key).lstrip("-")
            if key == "password":
                if eq:
                    opts["password"] = val
                elif i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                    opts["password"] = argv[i + 1]
                    i += 1
                else:
                    opts["password"] = None  # prompt
            elif key in VALUE_OPTS:
                if not eq:
                    i += 1
                    if i >= len(argv):
                        die(f"option --{key} requires a value")
                    val = argv[i]
                opts[key] = val
            elif key in FLAG_OPTS:
                opts[key] = True
            else:
                die(f"unknown option: {a}")
        else:
            pos.append(a)
        i += 1
    return pos, opts


def obtain_password(opts, *, existing=None):
    if "password" in opts:
        if opts["password"] is None:
            return getpass.getpass("Password: ")
        return opts["password"]
    if opts.get("generate"):
        return pysecrets.token_urlsafe(24)
    if opts.get("password-stdin"):
        return sys.stdin.readline().rstrip("\n")
    if existing is not None:
        return existing
    return None


# ------------------------------------------------------------------- commands
def cmd_list(pos, opts):
    conn = connect()
    sql = "SELECT * FROM entries"
    where, params = [], []
    if opts.get("type"):
        where.append("type = ?")
        params.append(opts["type"])
    if opts.get("tag"):
        where.append("COALESCE(tags, '') LIKE ?")
        params.append(f"%{opts['tag']}%")
    if where:
        sql += " WHERE " + " AND ".join(where)
    sql += " ORDER BY name"
    rows = conn.execute(sql, params).fetchall()

    if opts.get("json"):
        out = []
        for r in rows:
            d = dict(r)
            if not opts.get("show-passwords"):
                d.pop("password", None)
            out.append(d)
        print(json.dumps(out, indent=2))
        return

    if not rows:
        print(yellow("No entries stored."))
        return

    cols = ["name", "type", "username", "url", "description"]
    if opts.get("show-passwords"):
        cols.insert(3, "password")
    table = [[r[c] or "" for c in cols] for r in rows]
    headers = [c.capitalize() for c in cols]
    widths = [len(h) for h in headers]
    for row in table:
        for j, cell in enumerate(row):
            widths[j] = max(widths[j], len(cell))

    print(cyan("  ".join(h.ljust(widths[j]) for j, h in enumerate(headers))))
    print(dim("  ".join("-" * widths[j] for j in range(len(cols)))))
    for row in table:
        print("  ".join(cell.ljust(widths[j]) for j, cell in enumerate(row)))
    print(dim(f"\n{len(rows)} entr{'y' if len(rows) == 1 else 'ies'}."))


def cmd_show(pos, opts):
    if not pos:
        die("usage: secrets show <name>")
    conn = connect()
    row, _ = resolve(conn, pos[0])
    if not row:
        die(f"entry not found: {pos[0]}")
    print(bold(row["name"]) + dim(f"  (id {row['id']})"))
    for f in FIELDS:
        val = row[f]
        if val:
            print(f"  {cyan(LABELS[f].ljust(12))} {val}")
    print(f"  {cyan('Created'.ljust(12))} {row['created_at']}")
    print(f"  {cyan('Updated'.ljust(12))} {row['updated_at']}")


def cmd_get(pos, opts):
    if not pos:
        die("usage: secrets get <name> [--field password]")
    conn = connect()
    row, implied = resolve(conn, pos[0])
    if not row:
        die(f"entry not found: {pos[0]}")
    field = opts.get("field") or implied or "password"
    if field not in FIELDS:
        die(f"unknown field: {field} (one of: {', '.join(FIELDS)})")
    val = row[field]
    if not val:
        die(f"field '{field}' is empty for {row['name']}", 2)
    print(val)


def cmd_upsert(pos, opts, update):
    if not pos:
        die(f"usage: secrets {'set' if update else 'add'} <name> [options]")
    name = pos[0]
    conn = connect()
    existing = conn.execute("SELECT * FROM entries WHERE name = ?", (name,)).fetchone()
    if existing and not update:
        die(f"entry '{name}' already exists (use 'secrets set' to update)")

    data = {f: opts[f] for f in FIELDS if f in opts}
    data["password"] = obtain_password(
        opts, existing=existing["password"] if existing else None
    )
    if not data.get("type"):
        data.pop("type", None)

    if existing:
        sets, params = [], []
        for f, v in data.items():
            if v is None:
                continue
            sets.append(f"{f} = ?")
            params.append(v)
        sets.append("updated_at = CURRENT_TIMESTAMP")
        params.append(name)
        conn.execute(f"UPDATE entries SET {', '.join(sets)} WHERE name = ?", params)
        action = "Updated"
    else:
        data.setdefault("type", "login")
        cols = ["name"] + list(data.keys())
        conn.execute(
            f"INSERT INTO entries ({', '.join(cols)}) "
            f"VALUES ({', '.join('?' * len(cols))})",
            [name] + list(data.values()),
        )
        action = "Stored"
    conn.commit()
    enforce_perms()
    print(green(f"{action}: {name}"))


def cmd_rm(pos, opts):
    if not pos:
        die("usage: secrets rm <name> [--yes]")
    conn = connect()
    row, _ = resolve(conn, pos[0])
    if not row:
        die(f"entry not found: {pos[0]}")
    if not opts.get("yes"):
        reply = input(f"Delete '{row['name']}'? [y/N] ").strip().lower()
        if reply not in ("y", "yes"):
            print("Aborted.")
            return
    conn.execute("DELETE FROM entries WHERE id = ?", (row["id"],))
    conn.commit()
    print(green(f"Deleted: {row['name']}"))


def cmd_copy(pos, opts):
    if not pos:
        die("usage: secrets copy <name> [--field password]")
    conn = connect()
    row, implied = resolve(conn, pos[0])
    if not row:
        die(f"entry not found: {pos[0]}")
    field = opts.get("field") or implied or "password"
    val = row[field]
    if not val:
        die(f"field '{field}' is empty for {row['name']}", 2)
    tool = ["wl-copy"] if os.environ.get("WAYLAND_DISPLAY") else ["xclip", "-selection", "clipboard"]
    try:
        subprocess.run(tool, input=val, text=True, check=True)
    except (OSError, subprocess.CalledProcessError) as exc:
        die(f"clipboard unavailable ({exc}); value not copied")
    print(green(f"Copied {row['name']}.{field} to clipboard."))


def cmd_history(pos, opts):
    conn = connect()
    rows = conn.execute(
        "SELECT timestamp, type, dbname, username, permissions "
        "FROM user_creation_log ORDER BY timestamp DESC"
    ).fetchall()
    print(cyan("User Creation History:"))
    if not rows:
        print("  No user creation history found.")
        return
    headers = ["Timestamp", "Type", "DB Name", "Username", "Permissions"]
    data = [[str(r[0]), r[1] or "", r[2] or "", r[3] or "", r[4] or ""] for r in rows]
    widths = [len(h) for h in headers]
    for r in data:
        for j, cell in enumerate(r):
            widths[j] = max(widths[j], len(cell))
    print("  " + "  ".join(h.ljust(widths[j]) for j, h in enumerate(headers)))
    print("  " + "-" * (sum(widths) + 2 * (len(widths) - 1)))
    for r in data:
        print("  " + "  ".join(cell.ljust(widths[j]) for j, cell in enumerate(r)))


def cmd_export(pos, opts):
    fmt = (opts.get("format") or "").lower()
    outpath = opts.get("output")
    if fmt not in ("csv", "json"):
        if not fmt and outpath:
            ext = os.path.splitext(outpath)[1].lower().lstrip(".")
            fmt = ext if ext in ("csv", "json") else ""
        fmt = fmt or "json"
    if fmt not in ("csv", "json"):
        die(f"unsupported format: {fmt} (use csv or json)")

    conn = connect()
    columns = ["name", "type", "url", "username", "password", "description",
               "tags", "meta", "created_at", "updated_at"]
    if opts.get("no-passwords"):
        columns.remove("password")

    sql = f"SELECT {', '.join(columns)} FROM entries"
    where, params = [], []
    if opts.get("type"):
        where.append("type = ?")
        params.append(opts["type"])
    if opts.get("tag"):
        where.append("COALESCE(tags, '') LIKE ?")
        params.append(f"%{opts['tag']}%")
    if where:
        sql += " WHERE " + " AND ".join(where)
    sql += " ORDER BY name"
    rows = conn.execute(sql, params).fetchall()
    records = [{c: (r[c] if r[c] is not None else "") for c in columns} for r in rows]

    if fmt == "json":
        text = json.dumps(records, indent=2)
    else:
        buf = io.StringIO()
        writer = csv.DictWriter(buf, fieldnames=columns)
        writer.writeheader()
        writer.writerows(records)
        text = buf.getvalue()
    if not text.endswith("\n"):
        text += "\n"

    if outpath:
        os.makedirs(os.path.dirname(os.path.abspath(outpath)), exist_ok=True)
        with open(outpath, "w", newline="") as fh:
            fh.write(text)
        try:
            os.chmod(outpath, 0o600)
        except OSError:
            pass
        print(green(f"Exported {len(records)} entr"
                    f"{'y' if len(records) == 1 else 'ies'} to {outpath} ({fmt})."))
    else:
        if not opts.get("no-passwords") and sys.stdout.isatty():
            print(yellow("Warning: output includes passwords; add --no-passwords to omit."),
                  file=sys.stderr)
        sys.stdout.write(text)


def load_env(path):
    env = {}
    if not os.path.isfile(path):
        return env
    with open(path) as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            v = v.strip().strip('"').strip("'")
            env[k.strip()] = v
    return env


def log_user_creation(conn, type_, dbname, username, perms):
    conn.execute(
        "INSERT INTO user_creation_log (type, dbname, username, permissions) "
        "VALUES (?, ?, ?, ?)",
        (type_, dbname, username, perms),
    )
    conn.commit()


def cmd_db_create_user(pos, opts):
    if len(pos) < 4:
        die("usage: secrets db create-user <postgres|mongo> <dbname> <username> <password>")
    type_, dbname, username, password = pos[:4]
    if type_ not in ("postgres", "mongo"):
        die(f"unsupported database type: {type_}")
    if not all((dbname, username, password)):
        die("dbname, username and password are required")
    for label, val in (("dbname", dbname), ("username", username)):
        if not val.replace("_", "").isalnum():
            die(f"invalid {label}: {val}")

    conn = connect()
    if type_ == "postgres":
        admin = conn.execute(
            "SELECT username, password FROM entries WHERE name = 'postgres_admin'"
        ).fetchone()
        env = load_env(os.path.join(LAB_DIR, "core", "postgres", ".env"))
        admin_user = (admin["username"] if admin else None) or env.get("POSTGRES_USER") or "admin"
        admin_pass = (admin["password"] if admin else None) or env.get("POSTGRES_PASSWORD")
        if not admin_pass:
            die("no postgres admin password found (entry 'postgres_admin' or core/postgres/.env)")
        print(yellow(f"Creating Postgres user '{username}' for DB '{dbname}'..."), flush=True)
        sql = (
            f"CREATE USER {username} WITH PASSWORD '{password}';\n"
            f"CREATE DATABASE {dbname};\n"
            f"GRANT ALL PRIVILEGES ON DATABASE {dbname} TO {username};\n"
            f"\\c {dbname}\n"
            f"GRANT ALL ON SCHEMA public TO {username};\n"
        )
        subprocess.run(
            ["docker", "exec", "-i", "postgres", "psql", "-U", admin_user, "-d", "postgres"],
            input=sql, text=True, check=True,
            env={**os.environ, "PGPASSWORD": admin_pass},
        )
        log_user_creation(conn, "postgres", dbname, username, "ALL PRIVILEGES, public schema")
    else:  # mongo
        env = load_env(os.path.join(LAB_DIR, "core", "mongo", ".env"))
        root_user = env.get("MONGO_INITDB_ROOT_USERNAME", "admin")
        root_pass = env.get("MONGO_INITDB_ROOT_PASSWORD", "")
        print(yellow(f"Creating MongoDB user '{username}' for DB '{dbname}'..."), flush=True)
        script = (
            f"db = db.getSiblingDB('{dbname}');"
            f"db.createUser({{user: '{username}', pwd: '{password}', "
            f"roles: [{{role: 'readWrite', db: '{dbname}'}}]}});"
        )
        subprocess.run(
            ["docker", "exec", "-i", "mongo", "mongosh", "-u", root_user, "-p", root_pass,
             "--authenticationDatabase", "admin", "--eval", script],
            check=True,
        )
        log_user_creation(conn, "mongo", dbname, username, "readWrite")


def cmd_scan(pos, opts):
    """Discover credentials from project .env files (read-only)."""
    print(cyan("Active Lab Credentials:"))
    for directory in SEARCH_DIRS:
        base = os.path.join(LAB_DIR, directory)
        if not os.path.isdir(base):
            continue
        for root, _dirs, files in os.walk(base):
            if root[len(base):].count(os.sep) >= 2:
                continue
            if ".env" not in files:
                continue
            print(yellow(f"--- {os.path.basename(root)} ---"))
            with open(os.path.join(root, ".env")) as fh:
                for line in fh:
                    if line.strip() and not line.startswith("#"):
                        print("  " + line.rstrip())


def cmd_help(*_):
    print(cyan("Secrets Manager - Lab Credentials & DB Access"))
    print(f"Usage: {green('secrets <command> [options]')}\n")
    print(yellow("Commands:"))
    print(f"  {green('list')} [--type T] [--tag TAG] [--json] [-s]   List stored entries.")
    print(f"  {green('show')} <name>                              Show all fields of an entry.")
    print(f"  {green('get')} <name> [--field F]                   Print one field (default: password).")
    print(f"  {green('add')} <name> [options]                     Create a new entry.")
    print(f"  {green('set')} <name> [options]                     Create or update an entry.")
    print(f"  {green('rm')} <name> [--yes]                        Delete an entry.")
    print(f"  {green('copy')} <name> [--field F]                  Copy a field to the clipboard.")
    print(f"  {green('export')} [--format csv|json] [--output F]   Export all entries (default: json to stdout).")
    print(f"  {green('scan')}                                     Show credentials found in project .env files.")
    print(f"  {green('history')}                                  Show DB user creation audit trail.")
    print(f"  {green('db create-user')} <postgres|mongo> <db> <user> <pass>")
    print()
    print(yellow("Entry options (add/set):"))
    print(f"  {green('--type')} T          One of: {', '.join(TYPES)}")
    print(f"  {green('--url')} U           Service URL / host")
    print(f"  {green('--username')} U      Username or email")
    print(f"  {green('--password')} [P]     Password (omit value to be prompted securely)")
    print(f"  {green('--password-stdin')}   Read password from stdin")
    print(f"  {green('--generate')}         Generate a random password")
    print(f"  {green('--description')} D   Free-form description")
    print(f"  {green('--tags')} a,b        Comma-separated tags")
    print(f"  {green('--meta')} JSON       Type-specific extras (e.g. scopes, host, port)")
    print()
    print(yellow("Export options (export/dump):"))
    print(f"  {green('--format')} csv|json  Output format (else inferred from --output extension)")
    print(f"  {green('--output')} FILE     Write to FILE with mode 600; defaults to stdout")
    print(f"  {green('--no-passwords')}    Omit the password column")
    print(f"  {green('--type')} T / {green('--tag')} TAG  Only export matching entries")
    print()
    print(dim(f"Database: {DB_PATH}"))


def main():
    argv = sys.argv[1:]
    if not argv:
        cmd_help()
        return
    command, rest = argv[0], argv[1:]
    if command in ("help", "-h", "--help"):
        cmd_help()
        return
    if command == "db":
        sub = rest[0] if rest else ""
        if sub == "create-user":
            pos, opts = parse_args(rest[1:])
            cmd_db_create_user(pos, opts)
        else:
            cmd_help()
        return

    pos, opts = parse_args(rest)
    dispatch = {
        "list": cmd_list, "ls": cmd_list,
        "show": cmd_show,
        "get": cmd_get,
        "add": lambda p, o: cmd_upsert(p, o, update=False),
        "set": lambda p, o: cmd_upsert(p, o, update=True),
        "rm": cmd_rm, "remove": cmd_rm, "delete": cmd_rm,
        "copy": cmd_copy,
        "export": cmd_export, "dump": cmd_export,
        "scan": cmd_scan,
        "history": cmd_history,
    }
    handler = dispatch.get(command)
    if not handler:
        die(f"unknown command: {command} (run 'secrets help')")
    handler(pos, opts)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
